# Database
# Docker Compose publishes 127.0.0.1:5433; the user-mode cluster from
# `npm run db:init` (see README) listens on the same port.
DATABASE_URL="postgresql://darbar:change-me-local-db-password@127.0.0.1:5433/darbar?schema=public"
# Only needed when using `docker compose up -d`; must match the password in
# DATABASE_URL above.
POSTGRES_PASSWORD="change-me-local-db-password"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
# Public base baked into certificate verification QR codes / verify links. On a
# production server set this to the real public domain (e.g. "https://darbarcomputer.edu.np").
# The QR resolver ignores localhost/loopback/private hosts, so a dev
# NEXT_PUBLIC_SITE_URL can never be baked into an issued certificate.
SITE_URL=""

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3001"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"

# Media (Cloudinary example)
# The app caps uploads at 5 MB (MEDIA_MAX_BYTES) and re-reads every uploaded
# asset from the Admin API before storing a Media row, so a reported size cannot
# be forged. Cloudinary still accepts the bytes first: also set a 5 MB
# max_file_size on the account / upload preset so an oversize file is rejected
# at the door instead of being uploaded and then destroyed.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional. Leave unset to auto-detect:
#   credentials present -> Cloudinary (production path)
#   no credentials + `next dev` -> uploads go to public/uploads (development only)
# Force one backend with: MEDIA_STORAGE_PROVIDER="cloudinary" | "local"
MEDIA_STORAGE_PROVIDER=""

# Email
RESEND_API_KEY=""
LEAD_NOTIFY_TO="admissions@yourdomain"
MAIL_FROM="DarbarTech <no-reply@yourdomain>"

# Spam protection. The site key MUST carry the NEXT_PUBLIC_ prefix: the widget is a
# client component and an unprefixed variable is invisible to it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# How the real client address is obtained, and the whole reason every rate limit
# is meaningful (docs 01 §S1):
#   hops       = read the right-most entry of X-Forwarded-For, i.e. the one our own
#                proxy appended. Safe behind Caddy alone. The default.
#   cloudflare = read CF-Connecting-IP. Only valid when the origin firewall accepts
#                traffic from Cloudflare's IP ranges and nothing else, because any
#                visitor can send that header.
TRUSTED_PROXY="hops"

# Reverse-proxy depth in front of this app. Rate limits and lead attribution read
# the client address from X-Forwarded-For, whose left-hand entries are written by
# the caller — only the entries appended by our own proxies can be trusted.
#   1 = Caddy in front of this app (the docs/08 deployment; the default)
#   2 = Cloudflare, then Caddy
# A directly exposed app (0 proxies) gets one shared rate-limit bucket for
# everyone, which throttles visitors instead of attackers.
TRUSTED_PROXY_HOPS="1"

# Addresses whose traffic is exempt from the per-IP counters on the public forms
# (reaudit N2): the campus's own public IP, and any office NAT you own. An
# institute has one address for the whole lab, so "5 sign-ups an hour per IP" is
# really "5 sign-ups an hour for the building" — on admission day the sixth
# student is turned away from a form the campus itself wants filled.
#   RATE_LIMIT_TRUSTED_IPS="202.79.32.10,27.116.40.5"
# Comma-separated, exact matches against the client address derived above. Leave
# empty to throttle everyone equally.
#
# What this does NOT switch off: Turnstile on every public form, and every
# counter keyed by account, email or user id (sign-in guard, password reset per
# address, verification resend per student). Those are the limits that stop one
# person; the IP-only ones only ever stopped the building.
RATE_LIMIT_TRUSTED_IPS=""

# Shared secret for POST /api/cron/<job> (docs 07 §2). Without it the cron route
# answers 401 to everything, including the scheduler: the nightly sweep of
# rate-limit buckets and the seat reconcile simply never run.
CRON_SECRET=""

# Error monitoring (docs 08 §5). Both are opt-in: with neither set the app logs
# to stdout exactly as before and sends nothing anywhere.
#
# Where the server posts a crash it could not handle — a Server Component
# render, a Route Handler, an uncaught Server Action, a cron job. Any HTTPS
# ingest that accepts a small JSON document works (Sentry, GlitchTip, a
# self-hosted collector, a log shipper webhook); no SDK is in the bundle and no
# credential travels in it. The payload is scrubbed before it is built, so it
# never carries a form value, a 2FA code, an email address or a phone number —
# see src/lib/error-report.ts.
ERROR_REPORT_ENDPOINT=""
# The browser half, posted to our own ingest route so the collector URL and its
# token stay server-side. Leave unset to install no error listeners at all.
# Set to the same path when you want client crashes reported:
#   NEXT_PUBLIC_ERROR_REPORT_ENDPOINT="/api/error-report"
NEXT_PUBLIC_ERROR_REPORT_ENDPOINT=""
