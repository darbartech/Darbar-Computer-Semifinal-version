# Database
# Docker Compose publishes 127.0.0.1:5433; the user-mode cluster from
# `npm run db:init` (see README) listens on the same port.
DATABASE_URL="postgresql://darbar:change-me-local-db-password@127.0.0.1:5433/darbar?schema=public"
# Only needed when using `docker compose up -d`; must match the password in
# DATABASE_URL above.
POSTGRES_PASSWORD="change-me-local-db-password"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
# Public base baked into certificate verification QR codes / verify links. On a
# production server set this to the real public domain (e.g. "https://darbarcomputer.edu.np").
# The QR resolver ignores localhost/loopback/private hosts, so a dev
# NEXT_PUBLIC_SITE_URL can never be baked into an issued certificate.
SITE_URL=""

# Auth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3001"
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"

# Media (Cloudinary example)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional. Leave unset to auto-detect:
#   credentials present -> Cloudinary (production path)
#   no credentials + `next dev` -> uploads go to public/uploads (development only)
# Force one backend with: MEDIA_STORAGE_PROVIDER="cloudinary" | "local"
MEDIA_STORAGE_PROVIDER=""

# Email
RESEND_API_KEY=""
LEAD_NOTIFY_TO="admissions@yourdomain"
MAIL_FROM="DarbarTech <no-reply@yourdomain>"

# Spam protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
