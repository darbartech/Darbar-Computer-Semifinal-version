{
  "name": "darbar-computer-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:test": "tsx --tsconfig scripts/tsconfig.scripts.json prisma/seed-test.ts",
    "db:studio": "prisma studio",
    "db:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-db.ps1 init",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-db.ps1 start -Port 5433",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-db.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-db.ps1 status -Port 5433",
    "verify:seed": "tsx --tsconfig scripts/tsconfig.scripts.json scripts/verify-seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/prisma-adapter": "^1.7.7",
    "@hookform/resolvers": "^5.0.0",
    "@next/mdx": "^16.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.27.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.10.1",
    "shadcn": "^3.8.3",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "vitest": "^2.1.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "braces": "^3.0.3"
  }
}
