generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  COUNSELOR
  INSTRUCTOR
  ACCOUNTANT
  RECEPTION
  STUDENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Drives the colour and heading of the popup visitors see.
enum NoticeType {
  HOLIDAY
  CLOSURE
  ANNOUNCEMENT
}

enum CourseLevel {
  BEGINNER
  BEGINNER_TO_INTERMEDIATE
  INTERMEDIATE
  ADVANCED
}

enum LearningMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum TimeSlot {
  MORNING
  DAY
  EVENING
  WEEKEND
}

enum PreferredBatch {
  MORNING
  DAY
  EVENING
  WEEKEND
  ANY
}

enum BatchStatus {
  UPCOMING
  OPEN
  FULL
  RUNNING
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELING_DONE
  DEMO_SCHEDULED
  ENROLLED
  LOST
  SPAM
}

enum LeadSource {
  WEBSITE_INQUIRY
  CONTACT_FORM
  WHATSAPP
  PHONE
  WALK_IN
  EVENT
  REFERRAL
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  OPEN_HOUSE
  CERTIFICATION
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum GalleryCategory {
  CAMPUS
  LABS
  EVENTS
  CLASSES
  CERTIFICATIONS
}

enum MediaSource {
  UPLOAD
  EXTERNAL
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  REJECTED
  WAITLISTED
}

enum StudentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionReviewStatus {
  SUBMITTED
  REVIEWED
  NEEDS_WORK
}

// ───────────── Users & auth ─────────────
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             Role      @default(EDITOR)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  batchesTaught       Batch[]                @relation("BatchInstructor")
  assignedLeads       Lead[]
  activities          LeadActivity[]
  posts               BlogPost[]
  media               Media[]
  auditLogs           AuditLog[]
  sessions            Session[]
  accounts            Account[]
  certificatesCreated Certificate[]
  studentProfile      StudentProfile?
  assignmentsCreated  Assignment[]           @relation("AssignmentAuthor")
  submissionsReviewed AssignmentSubmission[] @relation("SubmissionReviewer")
  invoicesCreated     Invoice[]              @relation("InvoiceCreator")
  paymentsReceived    Payment[]              @relation("PaymentReceiver")
  paymentsVoided      Payment[]              @relation("PaymentVoider")
  daysClosed          DayClose[]             @relation("DayCloser")
  twoFactor           TwoFactor?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Better Auth's two-factor plugin (fix guide §4): one row per staff account.
/// `secret` and `backupCodes` are stored encrypted with `AUTH_SECRET`, never as
/// plain text; `verified` is false while an authenticator is being enrolled, and
/// the two failure columns are how a guessed code is throttled.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([secret])
}

// ───────────── Media ─────────────
model Media {
  id           String      @id @default(cuid())
  source       MediaSource @default(UPLOAD)
  url          String
  publicId     String?
  alt          String      @default("")
  width        Int?
  height       Int?
  bytes        Int?
  mimeType     String?
  folder       String?
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  courses         Course[]
  posts           BlogPost[]
  events          Event[]
  gallery         GalleryItem[]
  testimonials    Testimonial[]
  notices         Notice[]
  team            TeamMember[]
  studentPhotos   StudentProfile[]   @relation("StudentPhoto")
  portfolioCovers PortfolioProject[] @relation("PortfolioCover")

  @@index([createdAt])
}

// ───────────── Courses ─────────────
model CategoryGroup {
  id         String     @id @default(cuid())
  slug       String     @unique
  label      String
  sortOrder  Int        @default(0)
  categories Category[]
}

model Category {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String        @unique
  description String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  groupId     String
  group       CategoryGroup @relation(fields: [groupId], references: [id])
  courses     Course[]

  @@index([groupId])
}

model Course {
  id     String        @id @default(cuid())
  slug   String        @unique
  status PublishStatus @default(DRAFT)

  title            String
  tagline          String
  shortDescription String
  overview         String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])

  level          CourseLevel
  durationWeeks  Int
  learningModes  LearningMode[]
  timeSlots      TimeSlot[]
  batchFrequency String?
  targetStudents String
  prerequisites  String?

  instituteCertificate   String
  industryCertifications String[]
  internship             String?
  seatsNote              String?
  feeNPR                 Int
  feeNote                String?

  skillsGained        String[]
  softwareTools       String[]
  portfolioProjects   String[]
  careerOpportunities String[]
  learningObjectives  String[]

  ctaText        String?
  seoTitle       String?
  seoDescription String?
  coverId        String?
  cover          Media?  @relation(fields: [coverId], references: [id], onDelete: SetNull)

  isFeatured    Boolean   @default(false)
  featuredOrder Int?
  sortOrder     Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  batches      Batch[]
  leads        Lead[]
  testimonials Testimonial[]
  certificates Certificate[]
  enrollments  Enrollment[]
  assignments  Assignment[]

  @@index([status, categoryId])
  @@index([isFeatured, featuredOrder])
}

model Batch {
  id           String      @id @default(cuid())
  courseId     String
  // Deleting a course must not silently erase its batches; archive instead.
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name         String
  startDate    DateTime    @db.Date
  timeSlot     TimeSlot
  seatsTotal   Int
  seatsTaken   Int         @default(0)
  status       BatchStatus @default(UPCOMING)
  /// The teacher of record (fix guide §5): what scopes an INSTRUCTOR's reads.
  instructorId String?
  instructor   User?       @relation("BatchInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  enrollments Enrollment[]

  @@index([courseId, startDate])
  @@index([instructorId])
}

// ───────────── CRM ─────────────
model Lead {
  id             String         @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  courseId       String?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle    String?
  preferredBatch PreferredBatch @default(ANY)
  message        String?
  source         LeadSource     @default(WEBSITE_INQUIRY)
  status         LeadStatus     @default(NEW)
  assignedToId   String?
  assignedTo     User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  lostReason     String?
  followUpAt     DateTime?
  /// Set when the status moves to ENROLLED (docs/05 §4.1: conversion metrics).
  enrolledAt     DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrerUrl String?

  consentAt DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// Set by the retention purge instead of DELETE, so a wrongly removed lead
  /// can be restored (docs 01 S13).
  deletedAt       DateTime?
  /// E.164 phone (+97798XXXXXXXX) used for duplicate detection; `phone` keeps
  /// exactly what the visitor typed (docs 04 §4).
  phoneNormalized String?
  /// Set when the lead is converted by staff (docs 04 §3).
  studentId       String?         @unique
  student         StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  activities LeadActivity[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
  @@index([courseId])
  @@index([phoneNormalized])
  @@index([deletedAt])
  @@index([followUpAt])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  body      String?
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  subject      String
  organization String?
  message      String
  status       MessageStatus @default(NEW)
  ipHash       String?
  createdAt    DateTime      @default(now())
  handledAt    DateTime?

  @@index([status, createdAt])
}

// ───────────── Content ─────────────
model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  status         PublishStatus @default(DRAFT)
  title          String
  excerpt        String
  contentMd      String
  coverId        String?
  cover          Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?
  readingMinutes Int           @default(1)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tags           Tag[]

  @@index([status, publishedAt])
}

model Tag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model Event {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           EventStatus   @default(DRAFT)
  title            String
  category         EventCategory
  startsAt         DateTime
  endsAt           DateTime?
  location         String
  shortDescription String
  fullDescription  String
  coverId          String?
  cover            Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  registrationUrl  String?
  capacity         Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, startsAt])
}

model FaqCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  faqs      Faq[]
}

model Faq {
  id          String      @id @default(cuid())
  categoryId  String
  category    FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  sortOrder   Int         @default(0)
  isPublished Boolean     @default(false)

  @@index([categoryId, sortOrder])
}

model GalleryItem {
  id          String          @id @default(cuid())
  mediaId     String
  media       Media           @relation(fields: [mediaId], references: [id])
  title       String?
  alt         String
  category    GalleryCategory
  takenAt     DateTime?
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)

  @@index([category, sortOrder])
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseLabel  String?
  quote        String
  rating       Int      @default(5)
  photoId      String?
  photo        Media?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  consentGiven Boolean  @default(false)
  consentNote  String?
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  role        String
  specialty   String?
  bio         String?
  photoId     String?
  photo       Media?  @relation(fields: [photoId], references: [id], onDelete: SetNull)
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)
}

// ───────────── Settings & ops ─────────────
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  summary    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// Monotonic sequence for human-readable numbers (certificate, student,
/// invoice, receipt). `UPDATE ... ON CONFLICT ... RETURNING` makes the value
/// race-free, which `max() + 1` over the row set is not.
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// One row per (limiter key, fixed window). `allow()` increments it with a
/// single upsert, so a parallel burst cannot all read the same count.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// ───────────── Certificate System ─────────────
enum CertificateStatus {
  DRAFT
  PENDING_ISSUE
  ISSUED
  REVOKED
  REISSUED
  EXPIRED
}

model CertificateSignatory {
  id           String   @id @default(cuid())
  name         String
  title        String
  designation  String
  signatureUrl String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  issuedSignatories CertificateIssuedSignatory[]

  @@index([isActive, displayOrder])
}

model CertificateTemplate {
  id           String   @id @default(cuid())
  name         String
  version      String
  layoutConfig Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certificates Certificate[]

  @@unique([name, version])
  @@index([isActive])
}

model Certificate {
  id                String            @id @default(cuid())
  certificateNumber String?           @unique
  verificationToken String?           @unique
  status            CertificateStatus @default(DRAFT)

  recipientName     String
  recipientIdNumber String?

  /// Optional link to a student-portal account so the certificate can appear
  /// in the owner's portal and portfolio. Kept nullable because certificates
  /// are issued before/without a portal account.
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName String

  // Rendered into the "grade badge" zone of the DarbarTech certificate template.
  grade           String?
  // Human-readable program duration, e.g. "4 Months". Rendered as the
  // duration sentence. Kept as text rather than derived so an issued
  // certificate always prints the duration that was current at issue time.
  programDuration String?

  completionDate DateTime?
  issueDate      DateTime?
  issuedAt       DateTime?
  revokedAt      DateTime?
  reissuedAt     DateTime?
  revokeCategory String?
  revokeReason   String?
  reissueReason  String?

  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  parentCertificateId String?
  parentCertificate   Certificate?  @relation("CertificateReissueChain", fields: [parentCertificateId], references: [id], onDelete: SetNull)
  childCertificates   Certificate[] @relation("CertificateReissueChain")

  pdfUrl   String?
  metadata Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             CertificateItem[]
  issuedSignatories CertificateIssuedSignatory[]

  @@index([status])
  @@index([courseId])
  @@index([issuedAt])
  @@index([createdById])
  @@index([parentCertificateId])
  @@index([studentId])
}

model CertificateItem {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  title         String
  subtitle      String?
  shortLabel    String?

  @@index([certificateId, order])
}

model CertificateIssuedSignatory {
  id            String                @id @default(cuid())
  certificateId String
  certificate   Certificate           @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  signatoryId   String?
  signatory     CertificateSignatory? @relation(fields: [signatoryId], references: [id], onDelete: SetNull)
  name          String
  title         String
  designation   String
  displayOrder  Int                   @default(0)

  @@index([certificateId, displayOrder])
  @@index([signatoryId])
}

// ───────────── Student Portal ─────────────
/// One row per self-registered student. Owns the private profile fields shown
/// in the portal and the public portfolio fields shown at /portfolio/[slug].
/// `phone` and `dateOfBirth` are private and must never be rendered publicly.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Server-generated public student code, `DT-STU-{year}-{NNNNN}`.
  studentCode String    @unique
  phone       String?
  dateOfBirth DateTime? @db.Date
  address     String?
  city        String?
  country     String?

  /// Portfolio / profile presentation fields.
  headline    String?
  bio         String?
  skills      String[]
  interests   String[]
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  photoId     String?
  photo       Media?   @relation("StudentPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  /// Public showcase toggle. `portfolioSlug` is the public URL segment.
  portfolioSlug   String? @unique
  portfolioPublic Boolean @default(false)

  /// Registration approval. A PENDING/REJECTED student may sign in but the
  /// portal is read-only until staff set this to APPROVED.
  approvalStatus  StudentApprovalStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments          Enrollment[]
  projects             PortfolioProject[]
  certificates         Certificate[]
  assignments          AssignmentSubmission[]
  assignmentRecipients AssignmentRecipient[]
  invoices             Invoice[]
  lead                 Lead?

  @@index([portfolioPublic])
  @@index([approvalStatus])
}

model Enrollment {
  id           String           @id @default(cuid())
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  // Enrollment history survives course deletion (docs 02: Restrict, not Cascade).
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId      String?
  batch        Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status       EnrollmentStatus @default(PENDING)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?
  note         String?
  /// Staff decision trail (docs 02 B6): why a request was rejected or waitlisted.
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  invoices Invoice[]

  // Uniqueness belongs to the LIVE statuses only. A plain
  // `@@unique([studentId, courseId])` here made a finished relationship permanent:
  // once a row was DROPPED, REJECTED or COMPLETED the student could never ask for
  // that course again, because the retake would collide with the history they are
  // allowed to have. The real guard is the partial unique index
  // `Enrollment_live_student_course_key` (see migration
  // 20261105140000_enrollment_live_unique) — Prisma cannot express a `WHERE`
  // clause, so the schema declares the lookup index and the migration declares
  // the constraint.
  @@index([studentId, courseId])
  @@index([courseId])
  @@index([batchId])
  @@index([studentId, status])
  @@index([batchId, status])
}

/// A portfolio project the student adds to their public showcase.
model PortfolioProject {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  coverId     String?
  cover       Media?         @relation("PortfolioCover", fields: [coverId], references: [id], onDelete: SetNull)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId, sortOrder])
}

/// A task one instructor sets for the students listed in `AssignmentRecipient`
/// (not the whole course). The course only groups the task and limits who can be
/// picked. Students answer with a link only — no file uploads here.
model Assignment {
  id           String        @id @default(cuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  title        String
  instructions String?
  dueDate      DateTime?
  status       PublishStatus @default(DRAFT)
  createdById  String?
  createdBy    User?         @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submissions AssignmentSubmission[]
  recipients  AssignmentRecipient[]

  @@index([courseId, status])
  @@index([status, dueDate])
}

/// One link per student per assignment; re-submitting updates the same row.
model AssignmentSubmission {
  id           String                 @id @default(cuid())
  assignmentId String
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  url          String
  reviewStatus SubmissionReviewStatus @default(SUBMITTED)
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?                  @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Who actually owes a task. The instructor ticks these students when creating
/// the assignment, so one course can carry different tasks per student.
/// `seenAt` is the notification read marker: null until the student opens the
/// assignments page.
model AssignmentRecipient {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seenAt       DateTime?
  createdAt    DateTime       @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId, seenAt])
  @@index([assignmentId])
}

/// A site-wide announcement every visitor can see: holiday closure, lab down,
/// exam notice. `startsAt`/`endsAt` bound the window the popup shows in, both
/// nullable so a notice can be undated or open-ended. `image` is the optional
/// picture above the message (a closure poster, a holiday greeting).
model Notice {
  id        String        @id @default(cuid())
  type      NoticeType    @default(ANNOUNCEMENT)
  title     String
  body      String
  startsAt  DateTime?
  endsAt    DateTime?
  status    PublishStatus @default(DRAFT)
  imageId   String?
  image     Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, endsAt])
}

// ───────────── Fees & payments ─────────────
/// Append-only ledger (docs 05). Money is whole NPR in an `Int`, matching
/// `Course.feeNPR`; a balance is never stored, it is computed from the payments.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  ESEWA
  KHALTI
  FONEPAY
  CONNECTIPS
  OTHER
}

/// A payment is never edited or deleted — `VOIDED` keeps the receipt number in
/// the sequence so the day book stays explainable.
enum PaymentStatus {
  RECEIVED
  VOIDED
}

// `PaymentProvider`, `IntentStatus` and the `PaymentIntent` table used to sit
// here as the gateway handshake from docs/05 §6. Nothing read or wrote them: the
// initiate/callback actions were never built, so the schema advertised a payment
// route no code could walk. They return with that phase, in their own migration —
// see prisma/migrations/20261106100000_drop_payment_intent.

/// A student's bill for one course/batch. `netAmount` is stored (not derived)
/// because it must stay exactly what was invoiced even if the course fee, or the
/// discount policy, changes later.
model Invoice {
  id           String         @id @default(cuid())
  number       String         @unique
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// The enrollment this bill came from. Nullable: a walk-in admission is
  /// invoiced before the enrollment row exists, and dropping the enrollment must
  /// not erase the money record.
  enrollmentId String?
  enrollment   Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  title          String
  grossAmount    Int
  discountAmount Int           @default(0)
  discountReason String?
  netAmount      Int
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?     @db.Date
  note           String?
  /// Voiding is the only way to change an issued invoice (docs 05 §2), so the
  /// reason is kept next to the row it explains.
  voidReason     String?
  createdById    String?
  createdBy      User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments InvoiceInstallment[]
  payments     Payment[]

  @@index([studentId, status])
  @@index([dueDate, status])
}

/// An instalment is a *schedule*, not a debt: payments settle the invoice, and
/// "next due" is derived from the earliest instalment whose cumulative amount
/// exceeds what has been paid (docs 05 §2).
model InvoiceInstallment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  seq       Int
  amount    Int
  dueDate   DateTime @db.Date

  @@unique([invoiceId, seq])
  @@index([dueDate])
}

model Payment {
  id        String  @id @default(cuid())
  receiptNo String  @unique
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount    Int
  method    PaymentMethod
  /// Bank slip / cheque / gateway reference — whatever the money came in on.
  /// Stored normalised (trimmed, inner spaces collapsed, upper case) so the index
  /// below cannot be fooled by two typings of one slip; see
  /// normalizePaymentReference() in src/lib/validators/fees.ts and
  /// prisma/migrations/20261106090000_payment_reference_normalized.
  /// One live receipt per (method, reference): a partial unique index keeps it that
  /// way (prisma/migrations/20261105110000_payment_reference_unique), because Prisma
  /// cannot express the WHERE clause. A VOIDED receipt leaves the index, so voiding
  /// the first frees the slip for the corrected receipt; CASH is outside it too,
  /// since cash has no slip to match.
  reference String?
  status    PaymentStatus @default(RECEIVED)

  receivedAt   DateTime @default(now())
  receivedById String?
  receivedBy   User?    @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?

  /// One value per opening of the payment dialog, sent with every click of Save.
  /// A double-click or a retry after a lost response comes back with this key
  /// already used, and the first receipt is reported instead of a second one.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([receivedAt])
}

/// A campus day that has been counted and shut (fix guide §2). `day` is the
/// Kathmandu calendar date, stored as UTC midnight so it matches the date the
/// day book prints rather than the server's zone. While a row exists, no receipt
/// can be added to or voided on that day — only `fee.reopenDay` can undo it.
model DayClose {
  id  String   @id @default(cuid())
  day DateTime @unique @db.Date

  /// The drawer as counted, in whole NPR, next to the system's cash total.
  cashCounted Int?
  note        String?

  closedById String?
  closedBy   User?   @relation("DayCloser", fields: [closedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
