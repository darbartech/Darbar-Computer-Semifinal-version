generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  COUNSELOR
  STUDENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Drives the colour and heading of the popup visitors see.
enum NoticeType {
  HOLIDAY
  CLOSURE
  ANNOUNCEMENT
}

enum CourseLevel {
  BEGINNER
  BEGINNER_TO_INTERMEDIATE
  INTERMEDIATE
  ADVANCED
}

enum LearningMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum TimeSlot {
  MORNING
  DAY
  EVENING
  WEEKEND
}

enum PreferredBatch {
  MORNING
  DAY
  EVENING
  WEEKEND
  ANY
}

enum BatchStatus {
  UPCOMING
  OPEN
  FULL
  RUNNING
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  COUNSELING_DONE
  DEMO_SCHEDULED
  ENROLLED
  LOST
  SPAM
}

enum LeadSource {
  WEBSITE_INQUIRY
  CONTACT_FORM
  WHATSAPP
  PHONE
  WALK_IN
  EVENT
  REFERRAL
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
  SPAM
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  OPEN_HOUSE
  CERTIFICATION
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum GalleryCategory {
  CAMPUS
  LABS
  EVENTS
  CLASSES
  CERTIFICATIONS
}

enum MediaSource {
  UPLOAD
  EXTERNAL
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
}

enum StudentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionReviewStatus {
  SUBMITTED
  REVIEWED
  NEEDS_WORK
}

// ───────────── Users & auth ─────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(EDITOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads       Lead[]
  activities          LeadActivity[]
  posts               BlogPost[]
  media               Media[]
  auditLogs           AuditLog[]
  sessions            Session[]
  accounts            Account[]
  certificatesCreated Certificate[]
  studentProfile      StudentProfile?
  assignmentsCreated  Assignment[]           @relation("AssignmentAuthor")
  submissionsReviewed AssignmentSubmission[] @relation("SubmissionReviewer")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ───────────── Media ─────────────
model Media {
  id           String      @id @default(cuid())
  source       MediaSource @default(UPLOAD)
  url          String
  publicId     String?
  alt          String      @default("")
  width        Int?
  height       Int?
  bytes        Int?
  mimeType     String?
  folder       String?
  uploadedById String?
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  courses         Course[]
  posts           BlogPost[]
  events          Event[]
  gallery         GalleryItem[]
  testimonials    Testimonial[]
  notices         Notice[]
  team            TeamMember[]
  studentPhotos   StudentProfile[]   @relation("StudentPhoto")
  portfolioCovers PortfolioProject[] @relation("PortfolioCover")

  @@index([createdAt])
}

// ───────────── Courses ─────────────
model CategoryGroup {
  id         String     @id @default(cuid())
  slug       String     @unique
  label      String
  sortOrder  Int        @default(0)
  categories Category[]
}

model Category {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String        @unique
  description String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  groupId     String
  group       CategoryGroup @relation(fields: [groupId], references: [id])
  courses     Course[]

  @@index([groupId])
}

model Course {
  id     String        @id @default(cuid())
  slug   String        @unique
  status PublishStatus @default(DRAFT)

  title            String
  tagline          String
  shortDescription String
  overview         String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])

  level          CourseLevel
  durationWeeks  Int
  learningModes  LearningMode[]
  timeSlots      TimeSlot[]
  batchFrequency String?
  targetStudents String
  prerequisites  String?

  instituteCertificate   String
  industryCertifications String[]
  internship             String?
  seatsNote              String?
  feeNPR                 Int
  feeNote                String?

  skillsGained        String[]
  softwareTools       String[]
  portfolioProjects   String[]
  careerOpportunities String[]
  learningObjectives  String[]

  ctaText        String?
  seoTitle       String?
  seoDescription String?
  coverId        String?
  cover          Media?  @relation(fields: [coverId], references: [id], onDelete: SetNull)

  isFeatured    Boolean   @default(false)
  featuredOrder Int?
  sortOrder     Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  batches      Batch[]
  leads        Lead[]
  testimonials Testimonial[]
  certificates Certificate[]
  enrollments  Enrollment[]
  assignments  Assignment[]

  @@index([status, categoryId])
  @@index([isFeatured, featuredOrder])
}

model Batch {
  id         String      @id @default(cuid())
  courseId   String
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime    @db.Date
  timeSlot   TimeSlot
  seatsTotal Int
  seatsTaken Int         @default(0)
  status     BatchStatus @default(UPCOMING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  enrollments Enrollment[]

  @@index([courseId, startDate])
}

// ───────────── CRM ─────────────
model Lead {
  id             String         @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  courseId       String?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle    String?
  preferredBatch PreferredBatch @default(ANY)
  message        String?
  source         LeadSource     @default(WEBSITE_INQUIRY)
  status         LeadStatus     @default(NEW)
  assignedToId   String?
  assignedTo     User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  lostReason     String?
  followUpAt     DateTime?
  /// Set when the status moves to ENROLLED (docs/05 §4.1: conversion metrics).
  enrolledAt     DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrerUrl String?

  consentAt DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  activities LeadActivity[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([phone])
  @@index([courseId])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      LeadActivityType
  body      String?
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([leadId, createdAt])
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String?
  subject      String
  organization String?
  message      String
  status       MessageStatus @default(NEW)
  ipHash       String?
  createdAt    DateTime      @default(now())
  handledAt    DateTime?

  @@index([status, createdAt])
}

// ───────────── Content ─────────────
model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  status         PublishStatus @default(DRAFT)
  title          String
  excerpt        String
  contentMd      String
  coverId        String?
  cover          Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String?
  readingMinutes Int           @default(1)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tags           Tag[]

  @@index([status, publishedAt])
}

model Tag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model Event {
  id               String        @id @default(cuid())
  slug             String        @unique
  status           EventStatus   @default(DRAFT)
  title            String
  category         EventCategory
  startsAt         DateTime
  endsAt           DateTime?
  location         String
  shortDescription String
  fullDescription  String
  coverId          String?
  cover            Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  registrationUrl  String?
  capacity         Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, startsAt])
}

model FaqCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
  faqs      Faq[]
}

model Faq {
  id          String      @id @default(cuid())
  categoryId  String
  category    FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  sortOrder   Int         @default(0)
  isPublished Boolean     @default(false)

  @@index([categoryId, sortOrder])
}

model GalleryItem {
  id          String          @id @default(cuid())
  mediaId     String
  media       Media           @relation(fields: [mediaId], references: [id])
  title       String?
  alt         String
  category    GalleryCategory
  takenAt     DateTime?
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)

  @@index([category, sortOrder])
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseLabel  String?
  quote        String
  rating       Int      @default(5)
  photoId      String?
  photo        Media?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  consentGiven Boolean  @default(false)
  consentNote  String?
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model TeamMember {
  id          String  @id @default(cuid())
  name        String
  role        String
  specialty   String?
  bio         String?
  photoId     String?
  photo       Media?  @relation(fields: [photoId], references: [id], onDelete: SetNull)
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)
}

// ───────────── Settings & ops ─────────────
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  summary    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ───────────── Certificate System ─────────────
enum CertificateStatus {
  DRAFT
  PENDING_ISSUE
  ISSUED
  REVOKED
  REISSUED
  EXPIRED
}

model CertificateSignatory {
  id           String   @id @default(cuid())
  name         String
  title        String
  designation  String
  signatureUrl String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  issuedSignatories CertificateIssuedSignatory[]

  @@index([isActive, displayOrder])
}

model CertificateTemplate {
  id           String   @id @default(cuid())
  name         String
  version      String
  layoutConfig Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  certificates Certificate[]

  @@unique([name, version])
  @@index([isActive])
}

model Certificate {
  id                String            @id @default(cuid())
  certificateNumber String?           @unique
  verificationToken String?           @unique
  status            CertificateStatus @default(DRAFT)

  recipientName     String
  recipientIdNumber String?

  /// Optional link to a student-portal account so the certificate can appear
  /// in the owner's portal and portfolio. Kept nullable because certificates
  /// are issued before/without a portal account.
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  courseId   String?
  course     Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName String

  // Rendered into the "grade badge" zone of the DarbarTech certificate template.
  grade           String?
  // Human-readable program duration, e.g. "4 Months". Rendered as the
  // duration sentence. Kept as text rather than derived so an issued
  // certificate always prints the duration that was current at issue time.
  programDuration String?

  completionDate DateTime?
  issueDate      DateTime?
  issuedAt       DateTime?
  revokedAt      DateTime?
  reissuedAt     DateTime?
  revokeCategory String?
  revokeReason   String?
  reissueReason  String?

  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  parentCertificateId String?
  parentCertificate   Certificate?  @relation("CertificateReissueChain", fields: [parentCertificateId], references: [id], onDelete: SetNull)
  childCertificates   Certificate[] @relation("CertificateReissueChain")

  pdfUrl   String?
  metadata Json?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             CertificateItem[]
  issuedSignatories CertificateIssuedSignatory[]

  @@index([verificationToken])
  @@index([certificateNumber])
  @@index([status])
  @@index([courseId])
  @@index([issuedAt])
  @@index([createdById])
  @@index([parentCertificateId])
  @@index([studentId])
}

model CertificateItem {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  title         String
  subtitle      String?
  shortLabel    String?

  @@index([certificateId, order])
}

model CertificateIssuedSignatory {
  id            String                @id @default(cuid())
  certificateId String
  certificate   Certificate           @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  signatoryId   String?
  signatory     CertificateSignatory? @relation(fields: [signatoryId], references: [id], onDelete: SetNull)
  name          String
  title         String
  designation   String
  displayOrder  Int                   @default(0)

  @@index([certificateId, displayOrder])
  @@index([signatoryId])
}

// ───────────── Student Portal ─────────────
/// One row per self-registered student. Owns the private profile fields shown
/// in the portal and the public portfolio fields shown at /portfolio/[slug].
/// `phone` and `dateOfBirth` are private and must never be rendered publicly.
model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Server-generated public student code, `DT-STU-{year}-{NNNNN}`.
  studentCode String    @unique
  phone       String?
  dateOfBirth DateTime? @db.Date
  address     String?
  city        String?
  country     String?

  /// Portfolio / profile presentation fields.
  headline    String?
  bio         String?
  skills      String[]
  interests   String[]
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  photoId     String?
  photo       Media?   @relation("StudentPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  /// Public showcase toggle. `portfolioSlug` is the public URL segment.
  portfolioSlug   String? @unique
  portfolioPublic Boolean @default(false)

  /// Registration approval. A PENDING/REJECTED student may sign in but the
  /// portal is read-only until staff set this to APPROVED.
  approvalStatus  StudentApprovalStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments          Enrollment[]
  projects             PortfolioProject[]
  certificates         Certificate[]
  assignments          AssignmentSubmission[]
  assignmentRecipients AssignmentRecipient[]

  @@index([portfolioPublic])
  @@index([approvalStatus])
}

model Enrollment {
  id          String           @id @default(cuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  status      EnrollmentStatus @default(PENDING)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([batchId])
}

/// A portfolio project the student adds to their public showcase.
model PortfolioProject {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  coverId     String?
  cover       Media?         @relation("PortfolioCover", fields: [coverId], references: [id], onDelete: SetNull)
  sortOrder   Int            @default(0)
  isPublished Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([studentId, sortOrder])
}

/// A task one instructor sets for the students listed in `AssignmentRecipient`
/// (not the whole course). The course only groups the task and limits who can be
/// picked. Students answer with a link only — no file uploads here.
model Assignment {
  id           String        @id @default(cuid())
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  dueDate      DateTime?
  status       PublishStatus @default(DRAFT)
  createdById  String?
  createdBy    User?         @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submissions AssignmentSubmission[]
  recipients  AssignmentRecipient[]

  @@index([courseId, status])
  @@index([status, dueDate])
}

/// One link per student per assignment; re-submitting updates the same row.
model AssignmentSubmission {
  id           String                 @id @default(cuid())
  assignmentId String
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  url          String
  reviewStatus SubmissionReviewStatus @default(SUBMITTED)
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?                  @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

/// Who actually owes a task. The instructor ticks these students when creating
/// the assignment, so one course can carry different tasks per student.
/// `seenAt` is the notification read marker: null until the student opens the
/// assignments page.
model AssignmentRecipient {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seenAt       DateTime?
  createdAt    DateTime       @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId, seenAt])
  @@index([assignmentId])
}

/// A site-wide announcement every visitor can see: holiday closure, lab down,
/// exam notice. `startsAt`/`endsAt` bound the window the popup shows in, both
/// nullable so a notice can be undated or open-ended. `image` is the optional
/// picture above the message (a closure poster, a holiday greeting).
model Notice {
  id        String        @id @default(cuid())
  type      NoticeType    @default(ANNOUNCEMENT)
  title     String
  body      String
  startsAt  DateTime?
  endsAt    DateTime?
  status    PublishStatus @default(DRAFT)
  imageId   String?
  image     Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, endsAt])
}
